{
  "name": "project-management-system",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first macOS project dashboard with imports, project launch actions, and a user-installed skills registry.",
  "author": "jarven-bytes",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/jarven-bytes/codex-atlas.git" },
  "bugs": { "url": "https://github.com/jarven-bytes/codex-atlas/issues" },
  "engines": { "node": ">=22.12.0" },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node --import tsx src/server/main.ts",
    "build": "vite build",
    "build:desktop": "node scripts/build-server.mjs && vite build && node scripts/build-package-data.mjs",
    "desktop:dev": "npm run build:desktop && electron electron/main.cjs",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "prepare:github": "node scripts/prepare-github.mjs",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "package:mac": "npm run build:desktop && electron-builder --mac dir dmg",
    "sync:codex": "node --import tsx bin/codex-project-sync.ts"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
